{
  "name": "threads-smart-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "test": "node --test",
    "scan": "node --env-file=.env.local src/cli.mjs --source=mine --limit=25 --ai",
    "scan:search": "node --env-file=.env.local src/cli.mjs --source=search --ai",
    "orchestrate": "node --env-file=.env.local src/orchestrate-cli.mjs --ai",
    "feedback": "node src/feedback-cli.mjs",
    "learn": "node --env-file=.env.local src/learn-cli.mjs --ai",
    "profile": "node --env-file=.env.local src/cli.mjs --mode=profile"
  }
}
